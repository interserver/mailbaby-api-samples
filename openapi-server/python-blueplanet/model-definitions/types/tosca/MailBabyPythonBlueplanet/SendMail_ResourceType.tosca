"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "MailBabyPythonBlueplanet SendMail"
package     = MailBabyPythonBlueplanet
version     = "1.0"
description = "Defines a SendMail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  SendMailTo = MailBabyPythonBlueplanet.resourceTypes.SendMailTo
}
resourceTypes {

  SendMail {
    title = SendMail
    description = SendMail
    derivedFrom = Root
    properties {
        to {
          type = SendMailTo
          description = ""
          optional = true
        }
        _from {
          type =  string
          description = "The sender address.  This is used as both the &#x60;From&#x60; header and the &#x60;Reply-To&#x60; header automatically.  Must be a valid email address authorized for your mail order."
          optional = true
        }
        subject {
          type =  string
          description = "The subject line of the email."
          optional = true
        }
        body {
          type =  string
          description = "The email body.  If the string contains any HTML tags the message is automatically sent as &#x60;text/html&#x60;; otherwise it is sent as &#x60;text/plain&#x60;."
          optional = true
        }
        id {
          type =  integer
          description = "Optional numeric ID of the mail order to send through.  If omitted the first active order on your account is used automatically.  Valid IDs are returned by &#x60;GET /mail&#x60;."
          optional = false
        }
    }
  }
}

serviceTemplates {

  SendMail {
    title = SendMail
    description = SendMail
    implements = MailBabyPythonBlueplanet.resourceTypes.SendMail

  }
}
