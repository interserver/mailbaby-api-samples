"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "MailBabyPythonBlueplanet MailBlockRspamd"
package     = MailBabyPythonBlueplanet
version     = "1.0"
description = "Defines a MailBlockRspamd"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  MailBlockRspamd {
    title = MailBlockRspamd
    description = MailBlockRspamd
    derivedFrom = Root
    properties {
        _from {
          type =  string
          description = "The sender email address.  Pass this value as &#x60;email&#x60; to &#x60;POST /mail/blocks/delete&#x60; to delist the sender."
          optional = true
        }
        subject {
          type =  string
          description = "The suspicious subject pattern that triggered the block."
          optional = true
        }
    }
  }
}

serviceTemplates {

  MailBlockRspamd {
    title = MailBlockRspamd
    description = MailBlockRspamd
    implements = MailBabyPythonBlueplanet.resourceTypes.MailBlockRspamd

  }
}
