"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "MailBabyPythonBlueplanet MailBlocks"
package     = MailBabyPythonBlueplanet
version     = "1.0"
description = "Defines a MailBlocks"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MailBlockClickHouse = MailBabyPythonBlueplanet.resourceTypes.MailBlockClickHouse
  MailBlockRspamd = MailBabyPythonBlueplanet.resourceTypes.MailBlockRspamd
}
resourceTypes {

  MailBlocks {
    title = MailBlocks
    description = MailBlocks
    derivedFrom = Root
    properties {
        local {
          type = array
          items.type = MailBlockClickHouse
          description = "Messages flagged by the &#x60;LOCAL_BL_RCPT&#x60; rspamd rule in the last 5 days. These are messages sent to recipients on a local block list."
          optional = true
        }
        mbtrap {
          type = array
          items.type = MailBlockClickHouse
          description = "Messages flagged by the &#x60;MBTRAP&#x60; rspamd rule in the last 5 days. These triggered MailBaby&#39;s honeypot / trap address detection."
          optional = true
        }
        subject {
          type = array
          items.type = MailBlockRspamd
          description = "Senders whose messages contained spam-indicative subjects (containing &#x60;@&#x60;, &#x60;smtp&#x60;, &#x60;socks4&#x60;, or &#x60;socks5&#x60;) with more than 4 occurrences of the same subject in the last 3 days."
          optional = true
        }
    }
  }
}

serviceTemplates {

  MailBlocks {
    title = MailBlocks
    description = MailBlocks
    implements = MailBabyPythonBlueplanet.resourceTypes.MailBlocks

  }
}
