"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "MailBabyPythonBlueplanet MailLog"
package     = MailBabyPythonBlueplanet
version     = "1.0"
description = "Defines a MailLog"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MailLogEntry = MailBabyPythonBlueplanet.resourceTypes.MailLogEntry
}
resourceTypes {

  MailLog {
    title = MailLog
    description = MailLog
    derivedFrom = Root
    properties {
        total {
          type =  integer
          description = "Total number of log entries that match the supplied filters, regardless of &#x60;skip&#x60; and &#x60;limit&#x60;.  Use this to calculate the number of pages: &#x60;ceil(total / limit)&#x60;."
          optional = true
        }
        skip {
          type =  integer
          description = "The &#x60;skip&#x60; value used for this page (echoed from the request)."
          optional = true
        }
        limit {
          type =  integer
          description = "The &#x60;limit&#x60; value used for this page (echoed from the request)."
          optional = true
        }
        emails {
          type = array
          items.type = MailLogEntry
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  MailLog {
    title = MailLog
    description = MailLog
    implements = MailBabyPythonBlueplanet.resourceTypes.MailLog

  }
}
