          <xs:element minOccurs="0" maxOccurs="unbounded" name="attachments" type="">
            <xs:annotation>
              <xs:documentation>Optional list of file attachments.  Each file must be base64-encoded. Include &#x60;filename&#x60; so recipients see a meaningful attachment name.</xs:documentation>
