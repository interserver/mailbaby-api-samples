          <xs:element minOccurs="0" name="id" type="xs:long">
            <xs:annotation>
              <xs:documentation>Optional numeric ID of the mail order to send through.  If omitted the first active order on your account is used automatically.  Valid IDs are returned by &#x60;GET /mail&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
