{
  "namespace": "MailBabyAvroSchema",
  "type": "record",
  "doc": "A mail service order record.  Each order represents one provisioned sending account with a dedicated SMTP username.  The `id` is the numeric identifier used across most API calls.  The `username` is always `mb<id>` and is the SMTP AUTH username for `relay.mailbaby.net`.",
  "name": "MailOrder",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The unique numeric ID of the mail order.  Used as the `id` parameter on sending calls, log queries, and stats queries."
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "MailOrder_status",
        "symbols": [
          "active",
          "canceled",
          "11184809"
        ]
      },
      "doc": "The current order status.  Only `active` orders can be used for sending. `canceled` orders are retained for history but cannot send."
    },
    {
      "name": "username",
      "type": "string",
      "doc": "The SMTP AUTH username for this order, always in the format `mb<id>`. Use together with the password from `GET /mail/{id}` to authenticate directly against `relay.mailbaby.net:25` if needed."
    },
    {
      "name": "comment",
      "type": ["null", "string"],
      "doc": "Optional human-readable note associated with the order.  Only present in the response when the order has a non-empty comment.",
      "default": null
    }
  ]

}
