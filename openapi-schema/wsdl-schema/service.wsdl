          <xs:documentation>A flexible email address list that accepts either a plain RFC 822 string or a structured array of contact objects.  When a string is provided it is parsed as a comma-separated list of RFC 822 addresses (supporting the &#x60;\&quot;Name &lt;email&gt;\&quot;&#x60; and bare &#x60;email&#x60; formats).  When an array is provided each entry must have at least an &#x60;email&#x60; field with an optional &#x60;name&#x60; field.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:oneOf&lt;string,array&gt;">
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="SendMailTo">
        <xs:annotation>
          <xs:documentation>The primary recipient address for a simple send request. Accepts a single email address string or an array of email address strings for multiple recipients.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:oneOf&lt;string,array&gt;">
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Type">
        <xs:restriction base="xs:string">
          <xs:enumeration value="DOMAIN" />
          <xs:enumeration value="EMAIL" />
          <xs:enumeration value="STARTSWITH" />
          <xs:enumeration value="DESTINATION" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Time">
        <xs:restriction base="xs:string">
          <xs:enumeration value="All" />
          <xs:enumeration value="Billing" />
          <xs:enumeration value="Month" />
          <xs:enumeration value="SevenDays" />
          <xs:enumeration value="TwentyFourHours" />
