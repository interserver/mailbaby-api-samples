<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>MailBabyFsharpFunctions</Description>
    <Copyright>MailBabyFsharpFunctions</Copyright>
    <TargetFramework>netcoreapp2.1</TargetFramework>
    <AzureFunctionsVersion>v2</AzureFunctionsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Sdk.Functions" Version="1.0.24" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/model/SendMailTo.fs" />
    <Compile Include="src/model/SendMailRaw.fs" />
    <Compile Include="src/model/EmailAddressName.fs" />
    <Compile Include="src/model/SendMail.fs" />
    <Compile Include="src/model/MailStatsVolume.fs" />
    <Compile Include="src/model/MailStatsType.fs" />
    <Compile Include="src/model/MailOrderDetail.fs" />
    <Compile Include="src/model/MailOrder.fs" />
    <Compile Include="src/model/MailLogEntry.fs" />
    <Compile Include="src/model/MailLog.fs" />
    <Compile Include="src/model/MailBlockClickHouse.fs" />
    <Compile Include="src/model/MailBlockRspamd.fs" />
    <Compile Include="src/model/MailBlocks.fs" />
    <Compile Include="src/model/MailAttachment.fs" />
    <Compile Include="src/model/GenericResponse.fs" />
    <Compile Include="src/model/ErrorMessage.fs" />
    <Compile Include="src/model/EmailAddressTypes.fs" />
    <Compile Include="src/model/EmailAddressesTypes.fs" />
    <Compile Include="src/model/EmailAddressParam.fs" />
    <Compile Include="src/model/SendMailAdv.fs" />
    <Compile Include="src/model/DenyRuleRecord.fs" />
    <Compile Include="src/model/DenyRuleNew.fs" />
    <Compile Include="src/model/DateOrTimestamp.fs" />
    <Compile Include="src/api/BlockingApiHandlerParams.fs" />
    <Compile Include="src/api/BlockingApiServiceInterface.fs" />
    <Compile Include="src/impl/BlockingApiService.fs" />
    <Compile Include="src/api/BlockingApiHandler.fs" />
    <Compile Include="src/api/HistoryApiHandlerParams.fs" />
    <Compile Include="src/api/HistoryApiServiceInterface.fs" />
    <Compile Include="src/impl/HistoryApiService.fs" />
    <Compile Include="src/api/HistoryApiHandler.fs" />
    <Compile Include="src/api/SendingApiHandlerParams.fs" />
    <Compile Include="src/api/SendingApiServiceInterface.fs" />
    <Compile Include="src/impl/SendingApiService.fs" />
    <Compile Include="src/api/SendingApiHandler.fs" />
    <Compile Include="src/api/ServicesApiHandlerParams.fs" />
    <Compile Include="src/api/ServicesApiServiceInterface.fs" />
    <Compile Include="src/impl/ServicesApiService.fs" />
    <Compile Include="src/api/ServicesApiHandler.fs" />
    <Compile Include="src/api/StatusApiHandlerParams.fs" />
    <Compile Include="src/api/StatusApiServiceInterface.fs" />
    <Compile Include="src/impl/StatusApiService.fs" />
    <Compile Include="src/api/StatusApiHandler.fs" />
  </ItemGroup>

</Project>