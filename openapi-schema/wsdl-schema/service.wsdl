            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="GenericResponse">
        <xs:annotation>
          <xs:documentation>Standard success response returned by write operations (send, add rule, delete, etc.).  The &#x60;status&#x60; field is always &#x60;\&quot;ok\&quot;&#x60; on success.  The &#x60;text&#x60; field carries operation-specific data — for sending calls it contains the relay transaction ID; for create calls it contains the new record&#39;s ID; for delete calls it contains a confirmation string.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="status" type="xs:string">
            <xs:annotation>
              <xs:documentation>Always &#x60;\&quot;ok\&quot;&#x60; on success.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="text" type="xs:string">
            <xs:annotation>
              <xs:documentation>Operation-specific result string.  For send operations this is the relay transaction ID (e.g. &#x60;185caa69ff7000f47c&#x60;) which can be used as the &#x60;mailid&#x60; parameter in &#x60;GET /mail/log&#x60;.  For create operations this is the new record&#39;s numeric ID.  For delete operations this is a human-readable confirmation.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailAttachment">
        <xs:annotation>
          <xs:documentation>A file attachment for use with &#x60;POST /mail/advsend&#x60;.  The file content must be base64-encoded.  The &#x60;filename&#x60; is shown to recipients in their email client.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="filename" type="xs:string">
            <xs:annotation>
              <xs:documentation>The filename shown to recipients (e.g. &#x60;report.pdf&#x60;, &#x60;invoice.xlsx&#x60;).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="data" type="xs:string">
            <xs:annotation>
              <xs:documentation>The file contents as a base64-encoded string.  Decode this to retrieve the original binary file.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailBlockClickHouse">
        <xs:annotation>
          <xs:documentation>A block event record sourced from the ClickHouse analytics store.  Represents a message that triggered one of the rspamd block rules (&#x60;LOCAL_BL_RCPT&#x60; or &#x60;MBTRAP&#x60;). The &#x60;from&#x60; address can be passed to &#x60;POST /mail/blocks/delete&#x60; to delist it.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="date" type="xs:date">
            <xs:annotation>
              <xs:documentation>The date the block event was recorded.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="from" type="xs:string">
            <xs:annotation>
              <xs:documentation>The SMTP envelope sender (&#x60;MAIL FROM&#x60;) address of the blocked message. Pass this value as &#x60;email&#x60; to &#x60;POST /mail/blocks/delete&#x60; to delist it.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="messageId" type="xs:string">
            <xs:annotation>
              <xs:documentation>The &#x60;Message-ID&#x60; header of the blocked message, or &#x60;null&#x60; if not present.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="subject" type="xs:string">
            <xs:annotation>
              <xs:documentation>The &#x60;Subject&#x60; header of the blocked message.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="to" type="xs:string">
            <xs:annotation>
              <xs:documentation>The serialized list of recipients of the blocked message.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailBlockRspamd">
        <xs:annotation>
          <xs:documentation>A block pattern sourced from the rspamd database.  Represents a sender whose recent messages contained suspicious subject lines (e.g. containing relay/proxy strings) repeated more than 4 times in the last 3 days. The &#x60;from&#x60; address can be passed to &#x60;POST /mail/blocks/delete&#x60; to delist it.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="from" type="xs:string">
            <xs:annotation>
              <xs:documentation>The sender email address.  Pass this value as &#x60;email&#x60; to &#x60;POST /mail/blocks/delete&#x60; to delist the sender.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="subject" type="xs:string">
            <xs:annotation>
              <xs:documentation>The suspicious subject pattern that triggered the block.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailBlocks">
        <xs:annotation>
          <xs:documentation>The complete set of blocked addresses and message patterns returned by &#x60;GET /mail/blocks&#x60;. Three independent block sources are combined into one response. Use &#x60;POST /mail/blocks/delete&#x60; with a &#x60;from&#x60; address from any entry to delist it.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="local" type="schemas:MailBlockClickHouse">
            <xs:annotation>
              <xs:documentation>Messages flagged by the &#x60;LOCAL_BL_RCPT&#x60; rspamd rule in the last 5 days. These are messages sent to recipients on a local block list.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="mbtrap" type="schemas:MailBlockClickHouse">
            <xs:annotation>
              <xs:documentation>Messages flagged by the &#x60;MBTRAP&#x60; rspamd rule in the last 5 days. These triggered MailBaby&#39;s honeypot / trap address detection.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="subject" type="schemas:MailBlockRspamd">
            <xs:annotation>
              <xs:documentation>Senders whose messages contained spam-indicative subjects (containing &#x60;@&#x60;, &#x60;smtp&#x60;, &#x60;socks4&#x60;, or &#x60;socks5&#x60;) with more than 4 occurrences of the same subject in the last 3 days.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailLog">
        <xs:annotation>
          <xs:documentation>Paginated mail log response returned by &#x60;GET /mail/log&#x60;.  Contains the full matched count (&#x60;total&#x60;) plus a page of &#x60;MailLogEntry&#x60; records.  Use &#x60;skip&#x60; and &#x60;limit&#x60; to page through large result sets.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="total" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Total number of log entries that match the supplied filters, regardless of &#x60;skip&#x60; and &#x60;limit&#x60;.  Use this to calculate the number of pages: &#x60;ceil(total / limit)&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="skip" type="xs:integer">
            <xs:annotation>
              <xs:documentation>The &#x60;skip&#x60; value used for this page (echoed from the request).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="limit" type="xs:integer">
            <xs:annotation>
              <xs:documentation>The &#x60;limit&#x60; value used for this page (echoed from the request).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="emails" type="schemas:MailLogEntry" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailLogEntry">
        <xs:annotation>
          <xs:documentation>A single email record in the mail log.  Combines data from the message store (envelope metadata), the queue release table (delivery status and response), and the sender delivery table (MX routing details).  Key field relationships with other API calls: - The &#x60;id&#x60; field matches the &#x60;mailid&#x60; query parameter on &#x60;GET /mail/log&#x60; and   the &#x60;text&#x60; field of a successful send response. - The &#x60;from&#x60; address can be passed to &#x60;POST /mail/blocks/delete&#x60; to delist a   flagged sender. - The &#x60;user&#x60; field is the SMTP username (e.g. &#x60;mb5658&#x60;) corresponding to the   &#x60;username&#x60; field in &#x60;GET /mail&#x60; / &#x60;GET /mail/{id}&#x60;.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="_id" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Internal auto-increment database row ID.  Not meaningful outside the API.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="id">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>The relay-assigned mail ID (18–19 hex characters).  This is the value returned as &#x60;text&#x60; by the sending endpoints and accepted as the &#x60;mailid&#x60; filter on &#x60;GET /mail/log&#x60;.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:maxLength value="19" />
                <xs:minLength value="18" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="from" type="xs:string">
            <xs:annotation>
              <xs:documentation>SMTP envelope &#x60;MAIL FROM&#x60; address (may differ from the &#x60;From:&#x60; header).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="to" type="xs:string">
            <xs:annotation>
              <xs:documentation>SMTP envelope &#x60;RCPT TO&#x60; address.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="subject" type="xs:string">
            <xs:annotation>
              <xs:documentation>The &#x60;Subject&#x60; header value, if available.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="messageId" type="xs:string">
            <xs:annotation>
              <xs:documentation>The &#x60;Message-ID&#x60; header value, if present.  Can be used with the &#x60;messageId&#x60; filter on &#x60;GET /mail/log&#x60; for subsequent lookups.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="created" type="xs:string">
            <xs:annotation>
              <xs:documentation>Human-readable creation timestamp in &#x60;YYYY-MM-DD HH:MM:SS&#x60; format.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="time" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Unix timestamp of message acceptance.  Corresponds to the &#x60;startDate&#x60; and &#x60;endDate&#x60; filter parameters on &#x60;GET /mail/log&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="user" type="xs:string">
            <xs:annotation>
              <xs:documentation>The SMTP AUTH username used to submit the message (e.g. &#x60;mb5658&#x60;). Corresponds to the &#x60;username&#x60; field in &#x60;GET /mail&#x60; orders.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="transtype" type="xs:string">
            <xs:annotation>
              <xs:documentation>SMTP transaction type negotiated with the relay (e.g. &#x60;ESMTPSA&#x60;).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="origin" type="xs:string">
            <xs:annotation>
              <xs:documentation>IP address of the client that submitted the message to the relay. Corresponds to the &#x60;origin&#x60; filter parameter on &#x60;GET /mail/log&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="interface" type="xs:string">
            <xs:annotation>
              <xs:documentation>Relay interface name that accepted the message (e.g. &#x60;feeder&#x60;).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="sendingZone" type="xs:string">
            <xs:annotation>
              <xs:documentation>The sending zone assigned by the relay for outbound delivery.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="bodySize" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Size of the message body in bytes.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="seq" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Sequence index of this recipient in a multi-recipient message. Starts at 1.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="delivered" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Delivery status flag.  &#x60;1&#x60; &#x3D; successfully delivered to destination MX. &#x60;0&#x60; &#x3D; queued, deferred, or failed.  &#x60;null&#x60; &#x3D; delivery not yet attempted. Corresponds to the &#x60;delivered&#x60; filter parameter on &#x60;GET /mail/log&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="code" type="xs:integer">
            <xs:annotation>
              <xs:documentation>The SMTP response code from the destination MX server (e.g. &#x60;250&#x60; for success, &#x60;550&#x60; for permanent failure).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="response" type="xs:string">
            <xs:annotation>
              <xs:documentation>The SMTP response string received from the destination MX server upon delivery attempt (e.g. &#x60;\&quot;250 2.0.0 Ok queued as C91D83E128C\&quot;&#x60;).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="recipient" type="xs:string">
            <xs:annotation>
              <xs:documentation>The specific recipient address this delivery record is for.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="domain" type="xs:string">
            <xs:annotation>
              <xs:documentation>The destination domain.  Corresponds to the &#x60;mx&#x60; filter parameter (which matches &#x60;mxHostname&#x60;, not &#x60;domain&#x60;) on &#x60;GET /mail/log&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="locked" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Whether the queue entry is currently locked for delivery processing.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="lockTime" type="xs:string">
            <xs:annotation>
              <xs:documentation>Millisecond-precision timestamp of the last queue lock acquisition.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="assigned" type="xs:string">
            <xs:annotation>
              <xs:documentation>The relay server node assigned to deliver this message.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="queued" type="xs:string">
            <xs:annotation>
              <xs:documentation>ISO 8601 timestamp when the message was placed into the delivery queue.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="mxHostname" type="xs:string">
            <xs:annotation>
              <xs:documentation>The MX hostname the relay connected to for delivery.  Corresponds to the &#x60;mx&#x60; filter parameter on &#x60;GET /mail/log&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailOrder">
        <xs:annotation>
          <xs:documentation>A mail service order record.  Each order represents one provisioned sending account with a dedicated SMTP username.  The &#x60;id&#x60; is the numeric identifier used across most API calls.  The &#x60;username&#x60; is always &#x60;mb&lt;id&gt;&#x60; and is the SMTP AUTH username for &#x60;relay.mailbaby.net&#x60;.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:integer">
            <xs:annotation>
              <xs:documentation>The unique numeric ID of the mail order.  Used as the &#x60;id&#x60; parameter on sending calls, log queries, and stats queries.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="status" type="schemas:Status">
            <xs:annotation>
              <xs:documentation>The current order status.  Only &#x60;active&#x60; orders can be used for sending. &#x60;canceled&#x60; orders are retained for history but cannot send.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="username" type="xs:string">
            <xs:annotation>
              <xs:documentation>The SMTP AUTH username for this order, always in the format &#x60;mb&lt;id&gt;&#x60;. Use together with the password from &#x60;GET /mail/{id}&#x60; to authenticate directly against &#x60;relay.mailbaby.net:25&#x60; if needed.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="comment" type="xs:string">
            <xs:annotation>
              <xs:documentation>Optional human-readable note associated with the order.  Only present in the response when the order has a non-empty comment.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailOrderDetail">
        <xs:annotation>
          <xs:documentation>Extended mail order record including the current SMTP password.  Returned by &#x60;GET /mail/{id}&#x60;.  The &#x60;username&#x60; and &#x60;password&#x60; fields can be used to authenticate directly against &#x60;relay.mailbaby.net:25&#x60; via SMTP AUTH if you prefer to send via a native SMTP client rather than the REST API.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:integer">
            <xs:annotation>
              <xs:documentation>The unique numeric ID of the mail order.  Used as the &#x60;id&#x60; parameter on sending calls, log queries, and stats queries.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="status" type="schemas:Status">
            <xs:annotation>
              <xs:documentation>The current order status.  Only &#x60;active&#x60; orders can be used for sending. &#x60;canceled&#x60; orders are retained for history but cannot send.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="username" type="xs:string">
            <xs:annotation>
              <xs:documentation>The SMTP AUTH username for this order, always in the format &#x60;mb&lt;id&gt;&#x60;. Use together with the password from &#x60;GET /mail/{id}&#x60; to authenticate directly against &#x60;relay.mailbaby.net:25&#x60; if needed.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="comment" type="xs:string">
            <xs:annotation>
              <xs:documentation>Optional human-readable note associated with the order.  Only present in the response when the order has a non-empty comment.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="password" type="xs:string">
            <xs:annotation>
              <xs:documentation>The current SMTP AUTH password for this mail order.  Use with the &#x60;username&#x60; field to authenticate against &#x60;relay.mailbaby.net:25&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailStatsType">
        <xs:annotation>
          <xs:documentation>Account usage statistics returned by &#x60;GET /mail/stats&#x60;.  Includes billing-cycle usage totals (for cost calculation) as well as time-windowed sent/received counts and volume breakdowns by IP, destination, and source address.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" default="TimeEnum.OneHour" name="time" type="schemas:Time">
            <xs:annotation>
              <xs:documentation>The time window these &#x60;received&#x60;, &#x60;sent&#x60;, and &#x60;volume&#x60; statistics cover.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="usage" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Total messages accepted during the current billing cycle.  Used to calculate the &#x60;cost&#x60; value.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="currency" type="xs:string">
            <xs:annotation>
              <xs:documentation>The ISO 4217 currency code for this account (e.g. &#x60;USD&#x60;).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="cost" type="xs:double">
            <xs:annotation>
              <xs:documentation>Estimated cost for the current billing cycle combining the base plan price and per-email charges ($0.20/1000 emails).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="received" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Count of messages accepted by the relay within the selected &#x60;time&#x60; window. Includes messages still in queue.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="sent" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Count of messages successfully delivered to the destination MX within the selected &#x60;time&#x60; window.  Will be ≤ &#x60;received&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="volume" type="schemas:MailStatsVolume" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="MailStatsVolume">
        <xs:annotation>
          <xs:documentation>Top-500 breakdown of message counts within the selected time window, grouped by originating IP, destination address, and sender address.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="to" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Message counts keyed by destination (envelope &#x60;to&#x60;) email address.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="from" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Message counts keyed by sender (envelope &#x60;from&#x60;) email address.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="ip" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Message counts keyed by originating client IP address.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="SendMail">
        <xs:annotation>
          <xs:documentation>Request body for &#x60;POST /mail/send&#x60;.  Sends a simple single-recipient message. HTML detection is automatic — if &#x60;body&#x60; contains HTML tags the message is sent as &#x60;text/html&#x60;; otherwise as &#x60;text/plain&#x60;.  The &#x60;from&#x60; address is automatically set as both the &#x60;From&#x60; and &#x60;Reply-To&#x60; headers.  For multiple recipients, CC/BCC, attachments, or per-field Reply-To control, use &#x60;POST /mail/advsend&#x60; instead.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="to" type="schemas:SendMailTo" />
          <xs:element minOccurs="1" name="from" type="xs:string">
            <xs:annotation>
              <xs:documentation>The sender address.  This is used as both the &#x60;From&#x60; header and the &#x60;Reply-To&#x60; header automatically.  Must be a valid email address authorized for your mail order.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="subject" type="xs:string">
            <xs:annotation>
              <xs:documentation>The subject line of the email.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="body" type="xs:string">
            <xs:annotation>
              <xs:documentation>The email body.  If the string contains any HTML tags the message is automatically sent as &#x60;text/html&#x60;; otherwise it is sent as &#x60;text/plain&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="id" type="xs:long">
            <xs:annotation>
              <xs:documentation>Optional numeric ID of the mail order to send through.  If omitted the first active order on your account is used automatically.  Valid IDs are returned by &#x60;GET /mail&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="SendMailAdv">
        <xs:annotation>
          <xs:documentation>Request body for &#x60;POST /mail/advsend&#x60;.  Provides full control over all email headers and supports multiple recipients, CC, BCC, Reply-To, and file attachments.  Address fields (&#x60;from&#x60;, &#x60;to&#x60;, &#x60;replyto&#x60;, &#x60;cc&#x60;, &#x60;bcc&#x60;) each accept either a plain RFC 822 string (e.g. &#x60;\&quot;Joe &lt;joe@example.com&gt;\&quot;&#x60; or a comma-separated list) or a structured array of &#x60;{\&quot;email\&quot;: \&quot;...\&quot;, \&quot;name\&quot;: \&quot;...\&quot;}&#x60; objects.  HTML detection is automatic based on whether &#x60;body&#x60; contains HTML tags.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="subject" type="xs:string">
            <xs:annotation>
              <xs:documentation>The subject line of the email.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="body" type="xs:string">
            <xs:annotation>
              <xs:documentation>The email body.  If the string contains any HTML tags the message is automatically sent as &#x60;text/html&#x60;; otherwise it is sent as &#x60;text/plain&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="from" type="schemas:EmailAddressTypes">
            <xs:annotation>
              <xs:documentation>The sender address.  Accepts a plain email string, an RFC 822 named string (&#x60;\&quot;Name &lt;email&gt;\&quot;&#x60;), or a &#x60;{\&quot;email\&quot;: \&quot;...\&quot;, \&quot;name\&quot;: \&quot;...\&quot;}&#x60; object.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="to" type="schemas:EmailAddressesTypes">
            <xs:annotation>
              <xs:documentation>One or more destination addresses.  Accepts a comma-separated RFC 822 string or an array of contact objects.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="replyto" type="schemas:EmailAddressesTypes">
            <xs:annotation>
              <xs:documentation>Optional.  One or more addresses to set as the &#x60;Reply-To&#x60; header. When recipients reply to the message their email client will address the reply to these addresses instead of &#x60;from&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="cc" type="schemas:EmailAddressesTypes">
            <xs:annotation>
              <xs:documentation>Optional.  Carbon-copy recipients.  These addresses are listed in the &#x60;Cc&#x60; header and are visible to all recipients.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="bcc" type="schemas:EmailAddressesTypes">
            <xs:annotation>
              <xs:documentation>Optional.  Blind-carbon-copy recipients.  These addresses receive the message but are not listed in any visible header.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="attachments" type="schemas:MailAttachment">
            <xs:annotation>
              <xs:documentation>Optional list of file attachments.  Each file must be base64-encoded. Include &#x60;filename&#x60; so recipients see a meaningful attachment name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="id" type="xs:long">
            <xs:annotation>
              <xs:documentation>Optional numeric ID of the mail order to send through.  If omitted the first active order on your account is used automatically.  Valid IDs are returned by &#x60;GET /mail&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="SendMailRaw">
        <xs:annotation>
          <xs:documentation>Request body for &#x60;POST /mail/rawsend&#x60;.  Accepts a complete RFC 822 message (all headers and body) as a verbatim string.  The relay injects it without modification, preserving any existing &#x60;DKIM-Signature&#x60; header intact.  The &#x60;From&#x60;, &#x60;To&#x60;, &#x60;Cc&#x60;, and &#x60;Bcc&#x60; addresses are extracted from the message headers automatically — you do not need to specify them separately.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="raw_email" type="xs:string">
            <xs:annotation>
              <xs:documentation>The complete RFC 822 email message including all headers and the body. Must include at minimum &#x60;From&#x60;, &#x60;To&#x60;, &#x60;Subject&#x60;, &#x60;Date&#x60;, and &#x60;MIME-Version&#x60; headers.  DKIM signatures in the &#x60;DKIM-Signature&#x60; header are transmitted verbatim and will pass verification at the destination.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="id" type="xs:long">
            <xs:annotation>
              <xs:documentation>Optional numeric ID of the mail order to use for SMTP authentication. If omitted the first active order on your account is used.  Valid IDs are returned by &#x60;GET /mail&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="SendMailTo">
        <xs:annotation>
          <xs:documentation>The primary recipient address for a simple send request. Accepts a single email address string or an array of email address strings for multiple recipients.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="Type">
        <xs:annotation>
          <xs:documentation>The matching strategy for this rule.  &#x60;email&#x60; blocks an exact sender address, &#x60;domain&#x60; blocks all senders at a domain, &#x60;destination&#x60; blocks an exact recipient address, and &#x60;startswith&#x60; blocks any sender whose local-part begins with the given prefix.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="domain" />
          <xs:enumeration value="email" />
          <xs:enumeration value="startswith" />
          <xs:enumeration value="destination" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Status">
        <xs:annotation>
          <xs:documentation>The current order status.  Only &#x60;active&#x60; orders can be used for sending. &#x60;canceled&#x60; orders are retained for history but cannot send.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="active" />
          <xs:enumeration value="canceled" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Time">
        <xs:annotation>
          <xs:documentation>The time window these &#x60;received&#x60;, &#x60;sent&#x60;, and &#x60;volume&#x60; statistics cover.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="all" />
          <xs:enumeration value="billing" />
          <xs:enumeration value="month" />
          <xs:enumeration value="7d" />
          <xs:enumeration value="24h" />
          <xs:enumeration value="day" />
          <xs:enumeration value="1h" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="DateOrTimestamp">
        <xs:annotation>
          <xs:documentation>A date/time value accepted as either a Unix timestamp (integer seconds since epoch) or a date string parseable by &#x60;strtotime()&#x60; (e.g. &#x60;2024-01-15&#x60;, &#x60;last monday&#x60;).</xs:documentation>
        </xs:annotation>
