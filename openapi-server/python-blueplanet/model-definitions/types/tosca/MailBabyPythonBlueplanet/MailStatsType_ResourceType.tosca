"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "MailBabyPythonBlueplanet MailStatsType"
package     = MailBabyPythonBlueplanet
version     = "1.0"
description = "Defines a MailStatsType"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MailStatsVolume = MailBabyPythonBlueplanet.resourceTypes.MailStatsVolume
}
resourceTypes {

  MailStatsType {
    title = MailStatsType
    description = MailStatsType
    derivedFrom = Root
    properties {
        time {
          type =  string
          description = "The time window these &#x60;received&#x60;, &#x60;sent&#x60;, and &#x60;volume&#x60; statistics cover."
          enum = ["all", "billing", "month", "7d", "24h", "day", "1h"]
          optional = false
        }
        usage {
          type =  integer
          description = "Total messages accepted during the current billing cycle.  Used to calculate the &#x60;cost&#x60; value."
          optional = false
        }
        currency {
          type =  string
          description = "The ISO 4217 currency code for this account (e.g. &#x60;USD&#x60;)."
          optional = false
        }
        cost {
          type =  integer
          description = "Estimated cost for the current billing cycle combining the base plan price and per-email charges ($0.20/1000 emails)."
          optional = false
        }
        received {
          type =  integer
          description = "Count of messages accepted by the relay within the selected &#x60;time&#x60; window. Includes messages still in queue."
          optional = false
        }
        sent {
          type =  integer
          description = "Count of messages successfully delivered to the destination MX within the selected &#x60;time&#x60; window.  Will be ≤ &#x60;received&#x60;."
          optional = false
        }
        volume {
          type = MailStatsVolume
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  MailStatsType {
    title = MailStatsType
    description = MailStatsType
    implements = MailBabyPythonBlueplanet.resourceTypes.MailStatsType

  }
}
