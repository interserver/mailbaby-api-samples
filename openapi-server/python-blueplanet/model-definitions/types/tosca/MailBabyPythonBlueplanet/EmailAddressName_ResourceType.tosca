"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "MailBabyPythonBlueplanet EmailAddressName"
package     = MailBabyPythonBlueplanet
version     = "1.0"
description = "Defines a EmailAddressName"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  EmailAddressName {
    title = EmailAddressName
    description = EmailAddressName
    derivedFrom = Root
    properties {
        email {
          type =  string
          description = "The email address."
          optional = true
        }
        name {
          type =  string
          description = "Optional display name shown to recipients (e.g. in the &#x60;From:&#x60; header)."
          optional = false
        }
    }
  }
}

serviceTemplates {

  EmailAddressName {
    title = EmailAddressName
    description = EmailAddressName
    implements = MailBabyPythonBlueplanet.resourceTypes.EmailAddressName

  }
}
