"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "MailBabyPythonBlueplanet MailBlockClickHouse"
package     = MailBabyPythonBlueplanet
version     = "1.0"
description = "Defines a MailBlockClickHouse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  MailBlockClickHouse {
    title = MailBlockClickHouse
    description = MailBlockClickHouse
    derivedFrom = Root
    properties {
        _date {
          type =  string
          description = "The date the block event was recorded."
          optional = true
        }
        _from {
          type =  string
          description = "The SMTP envelope sender (&#x60;MAIL FROM&#x60;) address of the blocked message. Pass this value as &#x60;email&#x60; to &#x60;POST /mail/blocks/delete&#x60; to delist it."
          optional = true
        }
        subject {
          type =  string
          description = "The &#x60;Subject&#x60; header of the blocked message."
          optional = true
        }
        to {
          type =  string
          description = "The serialized list of recipients of the blocked message."
          optional = true
        }
        message_id {
          type =  string
          description = "The &#x60;Message-ID&#x60; header of the blocked message, or &#x60;null&#x60; if not present."
          optional = false
        }
    }
  }
}

serviceTemplates {

  MailBlockClickHouse {
    title = MailBlockClickHouse
    description = MailBlockClickHouse
    implements = MailBabyPythonBlueplanet.resourceTypes.MailBlockClickHouse

  }
}
